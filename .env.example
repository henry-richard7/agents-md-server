# ==============================================================================
# Skilldeck MCP Server Configuration
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
TRANSPORT=http               # Options: stdio, http, sse, streamable-http
LOG_LEVEL=INFO               # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security & HTTP Client Policies
ALLOW_PRIVATE_NETWORKS=false # Set to true only in development/trusted networks (SSRF protection)
HTTP_TIMEOUT_SECONDS=30.0    # Network timeout for external API calls
OAUTH_TOKEN_BUFFER_SECONDS=60 # Token expiration refresh safety buffer

# Custom Paths (optional, defaults to project root)
# SKILLS_DIR=./skills
# TOOLS_DIR=./tools
# AGENTS_MD_PATH=./AGENTS.md

# External Service Credentials (used by auth_http_fetch tool)
# Credentials are read server-side by variable name.
# Example:
# OPENAI_API_KEY=sk-...
# MY_SERVICE_API_KEY=secret-token
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=azure-secret-value
